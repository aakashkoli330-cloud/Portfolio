rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() == 'aakashkoli330@gmail.com';
    }

    match /project-covers/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portraits/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}